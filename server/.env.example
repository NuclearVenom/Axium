PORT=4000

# Required. Axium's entire knowledge engine — graph construction, expansion,
# and the AI tutor in the side panel — runs on Groq. Without this key set,
# the server starts but no graph can be generated.
GROQ_API_KEY_1=<api_key>

# Optional. Add more numbered keys (from additional Groq accounts/API keys)
# for automatic fallback — if GROQ_API_KEY_1 is rate-limited or invalid, the
# same request immediately retries with GROQ_API_KEY_2, and so on. Any
# number of keys is supported; add as many as you have.
# GROQ_API_KEY_2=<api_key>
# GROQ_API_KEY_3=<api_key>

# Optional locally, required on Vercel. When set, graph storage, the AI
# response cache, and usage counters are backed by Redis (Upstash) instead
# of local JSON files — necessary in production because Vercel's serverless
# filesystem is ephemeral and not shared across invocations. Leave these
# unset for local development; everything falls back to the data/ directory
# automatically. Provision via the Vercel Marketplace "Upstash for Redis"
# integration, which injects these two variables into your project for you.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
