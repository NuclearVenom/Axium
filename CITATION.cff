    given-names: "Ranasurya"
    alias: "NuclearVenom"
repository-code: "https://github.com/NuclearVenom/Axium"
url: "https://axium.vercel.app"
license: MIT
version: 0.1.0
keywords:
  - knowledge-graph
  - visualization
  - artificial-intelligence
  - education
  - large-language-models
  - interactive-learning
